# Образец окружения. Скопировать в .env и заполнить.
# .env в .gitignore — реальные значения в git не попадают.
# Проверка того, что настроено: GET /api/platform/health

# --- Базовое ----------------------------------------------------------------
NODE_ENV="development"
PORT="3000"
# Публичный HTTPS-адрес приложения. Обязателен для Telegram-webhook.
APP_URL=""
LOG_LEVEL="info"

# --- PostgreSQL --------------------------------------------------------------
# Локально поднимается через: docker compose up -d db
DATABASE_URL="postgres://commerceos:commerceos@localhost:5432/commerceos"
DATABASE_SSL="false"
DATABASE_MAX_POOL="10"

# --- Шифрование секретов продавцов -------------------------------------------
# base64 от 32 байт. Сгенерировать: npm run gen:key
# Потеря ключа = потеря всех сохранённых токенов магазинов.
SECRETS_ENCRYPTION_KEY=""
# Заполняется только на время смены ключа: им расшифровывают старые записи.
# Порядок: старый ключ сюда, новый в SECRETS_ENCRYPTION_KEY,
# затем npm run rotate:key -- --apply, затем убрать эту переменную.
SECRETS_ENCRYPTION_KEY_PREVIOUS=""

# --- AI ----------------------------------------------------------------------
GEMINI_API_KEY=""

# --- Telegram ----------------------------------------------------------------
# Токен от @BotFather.
TELEGRAM_BOT_TOKEN=""
# disabled | polling | webhook
# polling — для локальной разработки, webhook — для прода (нужен APP_URL по HTTPS).
TELEGRAM_MODE="disabled"
# Произвольная строка. Telegram шлёт её в заголовке X-Telegram-Bot-Api-Secret-Token,
# сервер сверяет и отбрасывает чужие запросы. Обязателен для webhook.
TELEGRAM_WEBHOOK_SECRET=""

# --- Интернационализация ------------------------------------------------------
DEFAULT_LOCALE="ru"
DEFAULT_TIMEZONE="Europe/Moscow"
DEFAULT_CURRENCY="RUB"

# --- Фичефлаги ----------------------------------------------------------------
# true — интерфейс работает на демо-данных из src/data/mockStore.
# Переключить в false, когда заработает первый коннектор.
USE_MOCK_DATA="true"
# Разрешить запись в маркетплейс (цены, остатки). Держать false, пока чтение
# не отработает на боевом токене хотя бы сутки.
ALLOW_MARKETPLACE_WRITES="false"

# --- Синхронизация ------------------------------------------------------------
# Как часто воркер сам ставит синхронизацию активным магазинам, минут.
# 0 — только вручную (/sync в боте или POST /api/platform/stores/:id/sync).
SYNC_INTERVAL_MINUTES="30"

# --- Токены для разовой проверки подключения ----------------------------------
# Используются только скриптом `npm run check:connection`, в приложение не попадают.
# WB_TEST_TOKEN=""
# OZON_TEST_TOKEN=""
