# Образец окружения для docker-compose.prod.yml.
# Скопировать в .env.production, заполнить, файл в git не коммитить.
#
#   docker compose -f docker-compose.prod.yml --env-file .env.production up -d --build

# --- База ---------------------------------------------------------------------
POSTGRES_USER="commerceos"
# Длинный случайный пароль. Не тот, что на машине разработки.
POSTGRES_PASSWORD=""
POSTGRES_DB="commerceos"

# --- Приложение ---------------------------------------------------------------
# Публичный HTTPS-адрес. По нему ставится Telegram webhook — без него бот не заработает.
APP_URL="https://example.com"
LOG_LEVEL="info"

# base64 от 32 байт: npm run gen:key
# ⚠️ Потеря ключа = потеря всех сохранённых токенов продавцов. Хранить в бэкапе
# отдельно от дампа базы: вместе они дают доступ ко всем магазинам клиентов.
SECRETS_ENCRYPTION_KEY=""
# Заполняется только на время смены ключа, затем убирается:
# npm run rotate:key -- --apply
SECRETS_ENCRYPTION_KEY_PREVIOUS=""

# --- Telegram -----------------------------------------------------------------
TELEGRAM_BOT_TOKEN=""
TELEGRAM_MODE="webhook"
# Длинная случайная строка, проверяется на каждом апдейте.
TELEGRAM_WEBHOOK_SECRET=""

# --- AI -----------------------------------------------------------------------
GEMINI_API_KEY=""

# --- Поведение ----------------------------------------------------------------
DEFAULT_LOCALE="ru"
DEFAULT_TIMEZONE="Europe/Moscow"
DEFAULT_CURRENCY="RUB"

# В проде демо-данные не показываем.
USE_MOCK_DATA="false"
# Держать false, пока чтение не отработает на боевом токене хотя бы сутки.
ALLOW_MARKETPLACE_WRITES="false"
SYNC_INTERVAL_MINUTES="30"
